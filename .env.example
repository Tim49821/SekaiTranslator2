# Copy the variables you need into .env and fill in real values there.
# .env is ignored by git.

BALLOONTRANS_LLM_OPENAI_API_KEY=
BALLOONTRANS_LLM_GOOGLE_API_KEY=
BALLOONTRANS_LLM_GROK_API_KEY=
BALLOONTRANS_LLM_OPENROUTER_API_KEY=

# Optional: semicolon-separated key rotation for translators.
BALLOONTRANS_LLM_OPENAI_API_KEYS=

# Optional: OCR-specific LLM keys. If omitted, OCR falls back to the matching
# BALLOONTRANS_LLM_<PROVIDER>_API_KEY value above.
BALLOONTRANS_LLM_OCR_OPENAI_API_KEY=
BALLOONTRANS_LLM_OCR_GOOGLE_API_KEY=
BALLOONTRANS_LLM_OCR_OPENROUTER_API_KEY=
