# Copy the variables you need into .env and fill in real values there.
# .env is ignored by git.

BALLOONTRANS_LLM_OPENAI_FREE_API_KEYS=
BALLOONTRANS_LLM_OPENAI_PAID_API_KEYS=
BALLOONTRANS_LLM_GOOGLE_FREE_API_KEYS=
BALLOONTRANS_LLM_GOOGLE_PAID_API_KEYS=
BALLOONTRANS_LLM_GROK_FREE_API_KEYS=
BALLOONTRANS_LLM_GROK_PAID_API_KEYS=
BALLOONTRANS_LLM_OPENROUTER_FREE_API_KEYS=
BALLOONTRANS_LLM_OPENROUTER_PAID_API_KEYS=

# Optional: semicolon-separated key rotation for translators.
# Legacy translator keys are still read as Free when a tier-aware Free
# variable is absent.
BALLOONTRANS_LLM_OPENAI_API_KEY=
BALLOONTRANS_LLM_OPENAI_API_KEYS=

# OCR keys use a separate namespace and never fall back to translator keys.
BALLOONTRANS_LLM_OCR_OPENAI_FREE_API_KEYS=
BALLOONTRANS_LLM_OCR_OPENAI_PAID_API_KEYS=
BALLOONTRANS_LLM_OCR_GOOGLE_FREE_API_KEYS=
BALLOONTRANS_LLM_OCR_GOOGLE_PAID_API_KEYS=
BALLOONTRANS_LLM_OCR_GROK_FREE_API_KEYS=
BALLOONTRANS_LLM_OCR_GROK_PAID_API_KEYS=
BALLOONTRANS_LLM_OCR_OPENROUTER_FREE_API_KEYS=
BALLOONTRANS_LLM_OCR_OPENROUTER_PAID_API_KEYS=

# Legacy OCR-only variables are still read as Free when the corresponding
# tier-aware OCR Free variable is absent.
BALLOONTRANS_LLM_OCR_OPENAI_API_KEY=
BALLOONTRANS_LLM_OCR_OPENAI_API_KEYS=
